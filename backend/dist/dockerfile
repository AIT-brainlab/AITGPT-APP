FROM ubuntu:24.04 AS production
ARG BUILD_VERSION
ENV BUILD_VERSION=$BUILD_VERSION
ARG PACKAGE_NAME
ARG VERSION   #  0.1.0
ARG TAG       # v0.1.0
ARG WORKDIR
# Ubuntu already have `ubuntu` user
ARG USERNAME=ubuntu
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Create the user
# RUN groupadd --gid $USER_GID $USERNAME \
#     && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME
#
# [Optional] Add sudo support. Omit if you don't need to install software after connecting.
RUN apt update
# && apt install -y sudo \
# && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
# && chmod 0440 /etc/sudoers.d/$USERNAME

# ********************************************************
# * Anything else you want to do like clean up goes here *
# ********************************************************

# Python 
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Essential 
RUN apt install -y --no-install-recommends ca-certificates
# Common tools
RUN apt install -y --no-install-recommends iputils-ping vim

RUN apt clean
RUN rm -rf /var/lib/apt/lists/*

# uv setup 
COPY --from=build /bin/uv /bin/uvx /bin/
# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1
# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy
# UV will instapp python in the ~/.local/uv/python by default which won't be cached when container is destroyed.
# Change the path to project folder so it easier to cache.
ENV UV_PYTHON_INSTALL_DIR=${WORKDIR}/.python
# Add uv tools path
ENV PATH="/home/${USERNAME}/.local/bin:$PATH"
# Place executables in the environment at the front of the path
ENV PATH="${WORKDIR}/.venv/bin:$PATH"

# [Optional] Set the default user. Omit if you want to keep the default as root.
USER $USERNAME
WORKDIR ${WORKDIR}
### option 1: without build
COPY --from=root --chown=${USER_UID}:${USER_GID} .python-version pyproject.toml uv.lock README.md ${WORKDIR}
COPY --from=root --chown=${USER_UID}:${USER_GID} django_manage.py ${WORKDIR}
COPY --from=root --chown=${USER_UID}:${USER_GID} src ${WORKDIR}/src
RUN uv sync
### option 1: with build
# COPY --from=build --chown=${USER_UID}:${USER_GID} ${WORKDIR}/dist ${WORKDIR}/dist
# RUN uv init
# RUN uv venv
# RUN uv pip install ./dist/${PACKAGE_NAME}-${VERSION}-py3-none-any.whl

EXPOSE 8000
# Reset the entrypoint, don't invoke `uv`
ENTRYPOINT []
# CMD ["sleep", "infinity"]
# CMD ["supervisord"]
CMD ["uv","run","python","django_manage.py","runserver","0.0.0.0:8000"]
