# LDAP Authentication Service Environment Variables Example
# Copy this file to .env and update with your actual LDAP server credentials

# LDAP Server Configuration
LDAP_SERVER_URI=ldaps://your-ldap-server.example.com:636
LDAP_BIND_DN=cn=service-account,ou=users,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-bind-password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_TLS_VALIDATE=False

# API Key for authentication (generate a secure random string)
LDAP_AUTH_API_KEY=your-secure-api-key-here
