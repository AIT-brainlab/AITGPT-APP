# Frontend Environment Variables Example
# Copy this file to .env and update with your actual values

# Backend API URL
# Use http://localhost:8000 for local development
# Use http://host.docker.internal:8000 when frontend runs in Docker and backend on host
VITE_API_URL=http://localhost:8000

# Compliance / policy-checker service (persons list, policy upload)
VITE_POLICY_API_URL=http://localhost:8005

# Policy module configuration
VITE_POLICY_MOCK=false

# Dev only: unlock Upload/Delete/Edit UI with a student LDAP account
# VITE_POLICY_DEV_ADMIN=true
